# =============================================================================
# PRESENCE System - Multi-stage Production Dockerfile
# =============================================================================

# Stage 1: Build client
FROM node:20-alpine AS client-build

WORKDIR /app/client

# Copy package files
COPY client/package*.json ./
COPY client/vite.config.ts ./
COPY client/tsconfig*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY client/src ./src
COPY client/public ./public

# Build for production
RUN npm run build

# Stage 2: Build server
FROM node:20-alpine AS server-build

WORKDIR /app/server

# Copy package files
COPY server/package*.json ./
COPY server/tsconfig*.json ./
COPY server/drizzle.config.ts ./

# Install dependencies
RUN npm ci --only=production

# Copy source code
COPY server/src ./src
COPY server/drizzle ./drizzle

# Build TypeScript
RUN npm run build

# Stage 3: Production image
FROM node:20-alpine AS production

# Set NODE_ENV
ENV NODE_ENV=production

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S presence -u 1001 -G nodejs

# Install necessary packages
RUN apk add --no-cache dumb-init curl openssl postgresql-client redis

# Create directories
RUN mkdir -p /app/uploads /app/logs /app/certs && \
    chown -R presence:nodejs /app

# Copy client build from stage 1
COPY --from=client-build /app/client/dist /app/client/dist
COPY --from=client-build /app/client/public /app/client/public

# Copy server from stage 2
COPY --from=server-build /app/server/dist /app/server/dist
COPY --from=server-build /app/server/package*.json /app/server/
COPY --from=server-build /app/server/drizzle.config.ts /app/server/

# Copy configuration files
COPY docker-entrypoint.sh /docker-entrypoint.sh
COPY .env.production /app/.env

# Change ownership
RUN chown -R presence:nodejs /app

# Switch to non-root user
USER presence

# Expose ports
EXPOSE 3000 5023

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Entrypoint
ENTRYPOINT ["/docker-entrypoint.sh"]

# Default command
CMD ["node", "server/dist/index.js"]
