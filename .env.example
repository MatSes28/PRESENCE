# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/clirdec_presence

# Application Configuration
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars
PORT=3000

# Email Service (Brevo)
BREVO_API_KEY=your-brevo-api-key-here
FROM_EMAIL=clirdecpresence@gmail.com

# WebSocket Configuration
WS_PORT=5023
WS_PATH=/ws

# IoT Device Configuration
DEFAULT_DEVICE_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=86400000
# IMPORTANT: Generate new secrets for production using:
# node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
# node -e "console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-new-secret-for-production
JWT_REFRESH_SECRET=generate-new-secret-for-production

# Password reset token TTL (minutes)
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Session cookie behavior
SESSION_COOKIE_SAMESITE=lax

# CORS Configuration (production: set FRONTEND_URL or ALLOWED_ORIGINS to your app origin(s))
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Logging
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Templates
EMAIL_TEMPLATES_PATH=./templates

# Cache Configuration (set REDIS_ENABLED=true in production for multi-server Emergency Stop & cache)
REDIS_ENABLED=false
# Set REDIS_REQUIRED=true when running multiple app instances or when Redis must be a hard dependency.
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Dangerous/maintenance endpoints (never enable in production)
ALLOW_FORCE_RESET_DEFAULTS=false
ALLOW_FIX_SESSION_ENDPOINT=false

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# IoT Device Security
# Generate strong API key for device authentication
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IOT_API_KEY=generate-new-iot-api-key-for-production

# Device Certificate Configuration
DEVICE_CERT_ENABLED=false
DEVICE_CERT_PATH=./certs/devices

# Real-time Attendance Settings
ATTENDANCE_BUFFER_SIZE=100
ATTENDANCE_BUFFER_TIMEOUT=5000

# Monitoring and Health Check
HEALTH_CHECK_INTERVAL=30000
ENABLE_METRICS=true
METRICS_PORT=9090
