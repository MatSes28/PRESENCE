# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/clirdec_presence

# Application Configuration
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars
PORT=3000

# Email Service (Brevo)
BREVO_API_KEY=your-brevo-api-key-here
FROM_EMAIL=clirdecpresence@gmail.com

# WebSocket Configuration
WS_PORT=5023
WS_PATH=/ws

# IoT Device Configuration
DEFAULT_DEVICE_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=86400000
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-very-secure-jwt-refresh-secret-key-min-32-characters-long-change-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Logging
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Templates
EMAIL_TEMPLATES_PATH=./templates

# Integration API Keys
GOOGLE_CLASSROOM_CLIENT_ID=your-google-classroom-client-id
GOOGLE_CLASSROOM_CLIENT_SECRET=your-google-classroom-client-secret
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:3000/auth/google/callback
MICROSOFT_TEAMS_CLIENT_ID=your-microsoft-teams-client-id
MICROSOFT_TEAMS_CLIENT_SECRET=your-microsoft-teams-client-secret
MICROSOFT_TEAMS_TENANT_ID=your-microsoft-teams-tenant-id
MOODLE_BASE_URL=https://your-moodle-instance.com
MOODLE_API_TOKEN=your-moodle-api-token
MOODLE_SERVICE=your-moodle-service-name

# Institutional Configuration
INSTITUTION_NAME=Your Institution Name
INSTITUTION_PROGRAM=BSIT
INSTITUTION_DEPARTMENT=DIT
INSTITUTION_COLLEGE=College of Engineering
INSTITUTION_LOCATION=CLIRDEC Building

# Cache Configuration
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.