{
  "name": "clirdec-presence",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "check": "npm run check --workspace=client && npm run check --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}