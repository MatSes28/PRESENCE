{
  "name": "clirdec-presence",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs",
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client && node scripts/copy-client-dist.mjs && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "db:push": "npm run db:push --workspace=server",
    "seed:dev": "node apply-sqlite-migrations.js && node scripts/seed-dev-sqlite.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "check": "npm run check --workspace=client && npm run check --workspace=server",
    "test:local": "npm test --workspace=client && npm run test:unit --workspace=server && npm run test:integration --workspace=server",
    "verify:local": "npm run security:secrets && npm run check && npm run build && npm audit --audit-level=moderate --workspaces && npm run test:local",
    "db:check-duplicates": "node scripts/check-attendance-duplicates.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "minimatch": "^10.2.4",
    "pg": "^8.18.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.7"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.8"
    },
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "esbuild": "0.25.12",
    "drizzle-orm": "0.45.2",
    "fast-uri": "3.1.2",
    "tmp": "0.2.5"
  }
}
