# Environment file for docker-compose.scaling.yml
#
# Usage:
#   copy to .env (or pass via --env-file)
#   docker compose -f docker-compose.scaling.yml up -d --build

# Database (docker-compose.scaling.yml)
DB_NAME=presence
DB_USER=presence_user
DB_PASSWORD=change-me-strong-db-password

# Redis
REDIS_PASSWORD=change-me-strong-redis-password

# App secrets (min 32 chars)
SESSION_SECRET=change-me-strong-session-secret-min-32-chars
JWT_SECRET=change-me-strong-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-strong-jwt-refresh-secret-min-32-chars

# CORS (required by fail-closed validation in production-like mode)
ALLOWED_ORIGINS=http://localhost:8080

