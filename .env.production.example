# CLIRDEC:PRESENCE Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL - Required)
# =============================================================================
# Use Railway PostgreSQL or your hosting provider's connection string
DATABASE_URL=postgresql://postgres:your_password@your-host.railway.app:5432/railway

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000
SESSION_SECRET=your-32-character-minimum-production-session-secret-key

# =============================================================================
# JWT SECURITY (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# =============================================================================
JWT_SECRET=your-jwt-secret-min-32-chars-hex-encoded-64-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-hex-encoded-64-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# EMAIL SERVICE (Brevo/Sendinblue)
# =============================================================================
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
FROM_EMAIL=clirdecpresence@gmail.com
FROM_NAME=CLIRDEC Presence System
EMAIL_TEMPLATES_PATH=./templates

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_PORT=5023
WS_PATH=/ws
IOT_WS_PATH=/iot

# =============================================================================
# IOT DEVICE CONFIGURATION
# =============================================================================
# MQTT Broker (optional - for advanced IoT setup)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Device timeout and heartbeat settings
DEFAULT_DEVICE_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000
DEVICE_OFFLINE_THRESHOLD=300000

# IoT Device Security
IOT_API_KEY=your-iot-device-api-key-min-32-chars

# =============================================================================
# CORS & SECURITY
# =============================================================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN_REGEX=https://.*\.yourdomain\.com

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_REQUESTS_AUTH=10
RATE_LIMIT_MAX_REQUESTS_API=100

# =============================================================================
# FILE UPLOADS
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
PROFILE_PICTURES_PATH=./uploads/profile-pictures

# =============================================================================
# REDIS CACHE (Optional - for session caching and rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
SESSION_CACHE_TTL=86400

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_PATH=./logs

# Metrics & Health Checks
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30000

# Performance Monitoring
PERFORMANCE_LOG_THRESHOLD=1000
SLOW_QUERY_THRESHOLD=1000

# =============================================================================
# ATTENDANCE SETTINGS
# =============================================================================
ATTENDANCE_BUFFER_SIZE=100
ATTENDANCE_BUFFER_TIMEOUT=5000
ATTENDANCE_GRACE_PERIOD=900000
AUTO_CLOSE_SESSION_TIMEOUT=1800000

# =============================================================================
# MAINTENANCE MODE
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under scheduled maintenance. Please try again later.
MAINTENANCE_ALLOW_API=false
MAINTENANCE_ALLOW_IPS=

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=86400000
SESSION_COOKIE_NAME=presence_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_COUNT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_MULTI_FACTOR_AUTH=false
FEATURE_DEVICE_CERTIFICATES=false
FEATURE_OFFLINE_ATTENDANCE=true
FEATURE_AI_ANALYTICS=true
FEATURE_MOBILE_APP=true

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# SMS Service (optional)
SMS_API_KEY=
SMS_API_URL=https://api.sms-service.com

# Cloud Storage (optional - for backup uploads)
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
CLOUD_STORAGE_REGION=

# =============================================================================
# DEPLOYMENT-SPECIFIC (Railway/Vercel/etc)
# =============================================================================
# Railway specific
RAILWAY_ENVIRONMENT=production
RAILWAY_SERVICE_NAME=clirdec-presence

# Custom domain (if using custom domain)
CUSTOM_DOMAIN=presence.yourdomain.com
HTTPS_ENABLED=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups
