# Production Environment Configuration
# IMPORTANT: Fill in all values before deployment
# Do not commit this file with real values to version control

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL connection string from your hosting provider
# Railway: Use ${{ RAILWAY_POSTGRESQL_URL }} in Railway dashboard
# Supabase: postgresql://postgres:password@host:6543/database
# Neon: postgresql://user:password@ep-xxx.region.neon.tech/database
DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# APPLICATION SECURITY (Required - Generate new values!)
# =============================================================================
# Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-session-secret-min-32-characters-long

# Generate using: node -e "console.log('JWT_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Generate using: node -e "console.log('JWT_REFRESH_SECRET=' + require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars

# =============================================================================
# EMAIL SERVICE (Brevo/Sendinblue)
# =============================================================================
# Get your API key from: https://app.brevo.com/settings/keys/smtp
BREVO_API_KEY=your-brevo-api-key-here
# Verify this email in Brevo sender settings
FROM_EMAIL=clirdecpresence@gmail.com
# Optional: Reply-to email
REPLY_TO_EMAIL=noreply@clirdec.edu.ph

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000

# =============================================================================
# CORS AND DOMAIN
# =============================================================================
# Your production domain (no trailing slash)
CLIENT_URL=https://presence.clirdec.edu.ph
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://presence.clirdec.edu.ph,https://admin.clirdec.edu.ph

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_PORT=5023
WS_PATH=/ws
# Enable WebSocket secure (WSS) in production
WS_SECURE=true

# =============================================================================
# IOT DEVICE CONFIGURATION
# =============================================================================
# Timeout for device heartbeat (milliseconds)
DEFAULT_DEVICE_TIMEOUT=60000
# Heartbeat interval from devices (milliseconds)
HEARTBEAT_INTERVAL=30000
# Maximum devices per classroom
MAX_DEVICES_PER_CLASSROOM=5
# Enable device auto-registration
DEVICE_AUTO_REGISTRATION=false
# Device API key for device management
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IOT_API_KEY=your-iot-api-key-here

# =============================================================================
# ATTENDANCE SETTINGS
# =============================================================================
# Late threshold in minutes
LATE_THRESHOLD_MINUTES=15
# Auto-close session after X minutes of no activity
AUTO_CLOSE_SESSION_MINUTES=120
# Enable RFID verification
RFID_VERIFICATION_ENABLED=true
# Enable sensor dual verification
DUAL_SENSOR_VERIFICATION=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
LOG_LEVEL=info
# Enable detailed error logging
DETAILED_ERROR_LOGS=true
# Enable performance metrics
ENABLE_METRICS=true
METRICS_PORT=9090
# Health check interval (milliseconds)
HEALTH_CHECK_INTERVAL=30000

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100
# IoT device rate limit
IOT_RATE_LIMIT_WINDOW=60000
IOT_RATE_LIMIT_MAX_REQUESTS=30

# =============================================================================
# CACHE AND PERFORMANCE
# =============================================================================
# Redis connection (optional - for session caching)
REDIS_URL=redis://localhost:6379
# Cache TTL for frequently accessed data (seconds)
CACHE_TTL_STUDENTS=300
CACHE_TTL_SCHEDULES=600
CACHE_TTL_CLASSROOMS=3600

# =============================================================================
# FILE UPLOADS
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
# Enable file encryption
ENCRYPT_UPLOADS=true

# =============================================================================
# DATABASE POOLING
# =============================================================================
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
SESSION_MAX_AGE=86400000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# MAINTENANCE MODE (Set to true during updates)
# =============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under scheduled maintenance. Please try again in a few minutes.

# =============================================================================
# EXTERNAL INTEGRATIONS (Optional)
# =============================================================================
# Google Classroom
GOOGLE_CLASSROOM_API_KEY=
# Microsoft Teams
MICROSOFT_TEAMS_CLIENT_ID=
MICROSOFT_TEAMS_CLIENT_SECRET=
# Moodle LMS
MOODLE_API_URL=
MOODLE_API_TOKEN=

# =============================================================================
# SSL AND CERTIFICATES (For production)
# =============================================================================
# SSL certificate path (if not using automatic HTTPS)
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Enable automatic database backups
AUTO_BACKUP_ENABLED=true
# Backup schedule (cron format - default: daily at 2 AM)
BACKUP_CRON=0 2 * * *
# Number of backups to retain
BACKUP_RETENTION_DAYS=30
# Backup storage path
BACKUP_PATH=./backups
# Optional: S3 bucket for remote backups
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
