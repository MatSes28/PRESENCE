{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "check": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=unit",
    "test:integration": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:jest": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=e2e",
    "test:load": "artillery run tests/load/artillery-api.yml",
    "test:load:iot": "artillery run tests/load/artillery-iot.yml",
    "test:load:all": "npm run test:load && npm run test:load:iot",
    "test:ci": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --coverage --watchAll=false --passWithNoTests",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:smoke": "npm run test:unit -- --testNamePattern=\"should log errors\" && npm run test:integration -- --testNamePattern=\"should create manual attendance\"",
    "test:quality": "npm run check && npm run test:unit -- --coverage --coverageThreshold='{\"global\":{\"branches\":75,\"functions\":85,\"lines\":85,\"statements\":85}}'",
    "test:security": "npm audit --audit-level=moderate && node --experimental-vm-modules ../node_modules/jest/bin/jest.js --testPathPattern=security"
  },
  "dependencies": {
    "@getbrevo/brevo": "^1.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/pdfkit": "^0.17.3",
    "@types/redis": "^4.0.10",
    "@types/speakeasy": "^2.0.10",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.5.0",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "csv-parser": "^3.2.0",
    "drizzle-orm": "^0.44.6",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.3.4",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "speakeasy": "^2.0.0",
    "validator": "^13.15.23",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.16",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.8",
    "@types/mqtt": "^2.5.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@types/validator": "^13.15.10",
    "@types/ws": "^8.5.8",
    "artillery": "^2.0.8",
    "drizzle-kit": "^0.31.7",
    "jest": "^29.7.0",
    "playwright": "^1.40.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vite": "7.2.4"
  }
}
