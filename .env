# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/clirdec_presence

# Application Configuration
NODE_ENV=development
SESSION_SECRET=your-super-secret-session-key-change-in-production-min-32-chars-long
PORT=3000

# Email Service (Brevo) - Optional for basic functionality
BREVO_API_KEY=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
FROM_EMAIL=matt.feria@clsu2.edu.ph

# WebSocket Configuration
WS_PORT=5023
WS_PATH=/ws

# IoT Device Configuration
DEFAULT_DEVICE_TIMEOUT=300000
HEARTBEAT_INTERVAL=30000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_MAX_AGE=86400000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Logging
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Templates
EMAIL_TEMPLATES_PATH=./templates

# Cache Configuration - Optional
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.